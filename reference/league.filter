#===============================================================================================================
# [[0200]] Gold
#===============================================================================================================
# !! Waypoint c0.gold : "All Rules - Including Gold" : "Gold"

Show # %H7 $type->gold $tier->stack3 !gold_huge
	StackSize >= 3001
	BaseType == "Gold"
	SetFontSize 45
	PlayEffect Yellow
	MinimapIcon 1 Yellow Cross
SetTextColor 255 212 87

Hide # %H6 $type->gold $tier->stack2 !gold_large
StackSize >= 1000
BaseType == "Gold"
SetFontSize 18
SetBackgroundColor 0 0 0 0

Hide # %H5 $type->gold $tier->stack1 !gold_medium
StackSize >= 150
BaseType == "Gold"
SetFontSize 18

Hide # %H5 $type->gold $tier->stacklvl1 !gold_medium
StackSize >= 50
BaseType == "Gold"
AreaLevel <= 68
SetFontSize 18

Hide # %H4 $type->gold $tier->anyother !gold_small
BaseType == "Gold"
SetFontSize 18

#===============================================================================================================
# [[0300]] Influenced Items
#===============================================================================================================
#------------------------------------
#   [0301] Influenced Maps
#------------------------------------
# !! Waypoint c1.infl.allplusmaps : "All rules - except gold and six-links" : "Maps"

#Hide  # # $type->maps->influenced $tier->zanacorrupthider !utility_shrunk
#	ZanaMemory True
#	Corrupted True
#	Rarity Normal Magic
#	Class == "Maps"
#	SetFontSize 35

Show # %H8 $type->maps->influenced $tier->zanamap !maps_t1
	ZanaMemory True
	MapTier >= 14
	Rarity Normal Magic Rare
	Class == "Maps"
	SetFontSize 45
	PlayAlertSound 1 300
	PlayEffect Yellow
	MinimapIcon 0 Yellow Square
SetBorderColor 220 220 220 0
SetTextColor 255 190 0

Show # %H6 $type->maps->influenced $tier->zanamaplow !maps_t2exotic
	ZanaMemory True
	Rarity Normal Magic Rare
	Class == "Maps"
	SetFontSize 45
	PlayEffect Yellow
	MinimapIcon 0 Yellow Square
SetTextColor 255 190 0
SetBorderColor 220 220 220 0
PlayAlertSound 1 300

Show # %H7 $type->maps->influenced $tier->infelder !maps_t1
	HasInfluence Elder
	MapTier >= 16
	Rarity Normal Magic Rare
	Class == "Maps"
	SetFontSize 45
	PlayAlertSound 1 300
	PlayEffect Yellow
	MinimapIcon 0 Yellow Square
SetBorderColor 220 220 220 0
SetTextColor 255 190 0

Show # %H8 $type->maps->influenced $tier->infconquerors !maps_t1
	HasInfluence Crusader Hunter Redeemer Warlord
	Rarity Normal Magic Rare
	Class == "Maps"
	SetFontSize 45
	PlayAlertSound 1 300
	PlayEffect Yellow
	MinimapIcon 0 Yellow Square
SetBorderColor 220 220 220 0
SetTextColor 255 190 0

