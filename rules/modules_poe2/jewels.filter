# "# [NNNN] title" keep NeverSink's numbering (emitters select by them).

# [2000] Jewels

Show # jewels->generic.anytimelost
	Rarity Normal Magic Rare
	Class == "Jewels"
	BaseType == "Time-Lost Emerald" "Time-Lost Ruby" "Time-Lost Sapphire"
	SetFontSize 45
	PlayAlertSound 3 300
	PlayEffect Blue
	MinimapIcon 0 Blue Diamond

Show # jewels->generic.anycorruptedmod
	AnyEnchantment True
	Corrupted True
	Rarity Normal Magic Rare
	Class == "Jewels"
	SetFontSize 45
	PlayAlertSound 3 300
	PlayEffect Blue
	MinimapIcon 0 Blue Diamond

Show # jewels->generic.any5modded
	Corrupted True
	Rarity Normal Magic Rare
	Class == "Jewels"
	HasExplicitMod >=5 "a" "o" "e" "u" "i" "y"
	SetFontSize 45
	PlayAlertSound 3 300
	PlayEffect Blue
	MinimapIcon 0 Blue Diamond

Show # jewels->generic.anyrare
	Rarity Rare
	Class == "Jewels"
	BaseType == "Emerald" "Ruby" "Sapphire"
	SetFontSize 45
	PlayAlertSound 2 300
	PlayEffect Yellow
	MinimapIcon 1 Yellow Diamond

Show # jewels->generic.anymagic %H5
	Rarity Normal Magic
	Class == "Jewels"
	BaseType == "Emerald" "Ruby" "Sapphire"
