# Generated by tools/import_neversink.py from reference/league-filterblade-poe2.filter, then ours: edit freely.
# Block header "Show # <key>": key toggled in modules_poe2.toml [id_mods.blocks]. Section lines
# "# [NNNN] title" keep NeverSink's numbering (emitters select by them).

# [0400] IDENTIFIED MODS: RECOMBINATOR MODS

Show # exoticmods.cmboots %D6
	Mirrored False
	Corrupted False
	Identified True
	Rarity Normal Magic Rare
	Class == "Boots"
	HasExplicitMod >=1 "Hellion's"
	SetFontSize 45
	PlayAlertSound 3 300
	PlayEffect Blue
	MinimapIcon 0 Blue Diamond

