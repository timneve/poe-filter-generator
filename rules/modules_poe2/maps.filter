# [2400] Normal Waystone Progression

Show # waystone->hiders.corruptedmaphider
	Corrupted True
	Rarity Normal Magic
	Class == "Waystones"
	SetFontSize 45
	SetTextColor 255 255 255 255
	PlayAlertSound 4 300
	MinimapIcon 2 White Square
	PlayEffect White

Show # waystone->hiders.mirroredmaphider
	Mirrored True
	Rarity Normal Magic
	Class == "Waystones"
	SetFontSize 45
	SetTextColor 255 255 255 255
	PlayAlertSound 4 300
	MinimapIcon 2 White Square
	PlayEffect White

