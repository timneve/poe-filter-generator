# [0900] Endgame Flasks

Show # endgame->flasks.toplevelqualityflasks %D5
	Mirrored False
	Corrupted False
	Quality > 10
	ItemLevel >= 83
	Rarity Normal Magic
	BaseType == "Ultimate Life Flask" "Ultimate Mana Flask"
	AreaLevel >= 65
	SetFontSize 45

