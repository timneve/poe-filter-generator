# Generated by tools/import_neversink.py from reference/league-filterblade-poe2.filter, then ours: edit freely.
# Block header "Show # <key>": key toggled in modules_poe2.toml [currency.blocks]. Section lines
# "# [NNNN] title" keep NeverSink's numbering (emitters select by them).

# [2500] Currency - Exceptions - Leveling Currencies

Show # currency->leveling.jewellers %D4
	Class == "Stackable Currency"
	BaseType == "Lesser Jeweller's Orb"
	AreaLevel <= 64
	MinimapIcon 1 White Circle
	PlayEffect White
	PlayAlertSound 2 300
	SetTextColor 255 255 255 255
	SetFontSize 42

