# Generated by tools/import_neversink.py from reference/league.filter, then ours: edit freely.
# Block header "Show # <key>": key toggled in modules.toml [leveling.blocks]. Section lines
# "# [NNNN] title" keep NeverSink's numbering (emitters select by them).

# [2802] Leveling Exceptions

Show # jewels->leveling.abyss %D3
	ItemLevel <= 67
	Rarity Normal Magic
	BaseType == "Ghastly Eye Jewel" "Hypnotic Eye Jewel" "Murderous Eye Jewel" "Searching Eye Jewel"
	SetFontSize 45

Show # jewels->leveling.generic %D3
	ItemLevel <= 67
	Rarity Normal Magic
	BaseType == "Cobalt Jewel" "Crimson Jewel" "Viridian Jewel"
	SetFontSize 45

