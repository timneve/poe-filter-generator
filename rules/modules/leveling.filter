# [5000] Hide outdated leveling flasks

Hide # hidelayer.outdatedlevelflaska !utility_layer
	Quality 0
	Class == "Life Flasks" "Mana Flasks"
	BaseType "Large" "Medium" "Small"
	AreaLevel >= 15
	SetFontSize 18
	DisableDropSound True

Hide # hidelayer.outdatedlevelflaskb !utility_layer
	Quality 0
	Class == "Life Flasks" "Mana Flasks"
	BaseType "Grand" "Greater"
	AreaLevel >= 30
	SetFontSize 18
	DisableDropSound True

Hide # hidelayer.outdatedlevelflaskc !utility_layer
	Quality 0
	Class == "Life Flasks" "Mana Flasks"
	BaseType "Colossal" "Giant" "Sacred"
	AreaLevel >= 48
	SetFontSize 18
	DisableDropSound True

Hide # hidelayer.outdatedlevelflaskd !utility_layer
	Quality 0
	Class == "Life Flasks" "Mana Flasks"
	BaseType "Hallowed" "Sanctified"
	AreaLevel >= 60
	SetFontSize 18
	DisableDropSound True

