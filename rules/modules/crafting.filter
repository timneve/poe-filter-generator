# [2301] Early Endgame Crafting projects

Show # normalcraft->extra.earlycraftoptional %D0
	Mirrored False
	Corrupted False
	Rarity Normal Magic
	BaseType == "Amethyst Ring" "Kinetic Wand" "Two-Stone Ring"
	AreaLevel <= 75
	AreaLevel >= 68
	SetFontSize 45

Show # normalcraft->extra.earlyendgame4link %D1
	Mirrored False
	Corrupted False
	LinkedSockets >= 4
	Rarity Normal Magic Rare
	Class == "Body Armours" "Boots" "Gloves" "Helmets"
	AreaLevel <= 75
	AreaLevel >= 68
	SetFontSize 45

