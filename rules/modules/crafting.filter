# Generated by tools/import_neversink.py from reference/league.filter, then ours: edit freely.
# Block header "Show # <key>": key toggled in modules.toml [crafting.blocks]. Section lines
# "# [NNNN] title" keep NeverSink's numbering (emitters select by them).

# [1401] Link Based

Show # socketslinks.5linksleveling %D4
	LinkedSockets >= 5
	Rarity Normal Magic Rare
	AreaLevel >= 2
	AreaLevel <= 67
	SetFontSize 45
	PlayAlertSound 3 300
	PlayEffect Yellow
	MinimapIcon 1 Yellow Diamond

Show # socketslinks.5link6sockets %D4
	LinkedSockets >= 5
	Sockets >= 6
	Rarity Normal Magic Rare
	SetFontSize 45
	PlayAlertSound 2 300
	PlayEffect Blue
	MinimapIcon 2 Blue Hexagon

Show # socketslinks.5links %D3
	LinkedSockets >= 5
	Rarity Normal Magic Rare
	AreaLevel >= 68
	SetFontSize 45
	PlayAlertSound 3 300
	PlayEffect Blue
	MinimapIcon 2 Blue Diamond

Show # socketslinks.rgbsmall1 %D5
	Width 2
	Height 2
	Rarity Normal Magic Rare
	SocketGroup "RGB"
	SetFontSize 45
	PlayAlertSound 2 300
	PlayEffect Grey
	MinimapIcon 2 Grey Hexagon

