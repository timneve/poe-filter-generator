# Generated by tools/import_neversink.py from reference/league.filter, then ours: edit freely.
# Block header "Show # <key>": key toggled in modules.toml [maps.blocks]. Section lines
# "# [NNNN] title" keep NeverSink's numbering (emitters select by them).

# [0301] Influenced Maps

Show # maps->influenced.zanamap
	ZanaMemory True
	MapTier >= 14
	Rarity Normal Magic Rare
	Class == "Maps"
	SetFontSize 45
	PlayAlertSound 1 300
	PlayEffect Yellow
	MinimapIcon 0 Yellow Square
	SetTextColor 255 190 0

