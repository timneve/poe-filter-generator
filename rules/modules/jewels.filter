# Generated by tools/import_neversink.py from reference/league.filter, then ours: edit freely.
# Block header "Show # <key>": key toggled in modules.toml [jewels.blocks]. Section lines
# "# [NNNN] title" keep NeverSink's numbering (emitters select by them).

# [2801] Special Cases

Show # jewels->special.1modcorrupted
	Corrupted True
	CorruptedMods >= 1
	Rarity Rare
	BaseType == "Cobalt Jewel" "Crimson Jewel" "Ghastly Eye Jewel" "Hypnotic Eye Jewel" "Murderous Eye Jewel" "Searching Eye Jewel" "Viridian Jewel"
	SetFontSize 45
	PlayAlertSound 3 300
	PlayEffect Blue
	MinimapIcon 2 Blue Diamond

Show # jewels->special.1moduncorrupted
	Identified True
	Rarity Normal Magic Rare
	BaseType == "Cobalt Jewel" "Crimson Jewel" "Viridian Jewel"
	HasExplicitMod "Shimmering" "Vivid" "Stalwart" "Resplendent" "Expediting"
	SetFontSize 45
	PlayAlertSound 3 300
	PlayEffect Blue
	MinimapIcon 2 Blue Diamond

Show # jewels->special.any
	Corrupted True
	CorruptedMods >= 1
	Rarity Magic
	BaseType == "Cobalt Jewel" "Crimson Jewel" "Viridian Jewel"
	SetFontSize 45
	PlayAlertSound 3 300
	PlayEffect Blue
	MinimapIcon 2 Blue Diamond

