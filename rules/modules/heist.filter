# Generated by tools/import_neversink.py from reference/league.filter, then ours: edit freely.
# Block header "Show # <key>": key toggled in modules.toml [heist.blocks]. Section lines
# "# [NNNN] title" keep NeverSink's numbering (emitters select by them).

# [2901] Heist Cloak

Show # heist->cloak.t1highlevel
	ItemLevel >= 83
	Rarity Normal Magic Rare
	Class == "Heist Cloaks"
	BaseType == "Whisper-woven Cloak"
	SetFontSize 45
	PlayAlertSound 3 300
	PlayEffect Yellow
	MinimapIcon 1 Yellow Raindrop

Show # heist->cloak.t1
	Rarity Normal Magic Rare
	Class == "Heist Cloaks"
	BaseType == "Whisper-woven Cloak"
	SetFontSize 45
	PlayAlertSound 3 300
	PlayEffect White
	MinimapIcon 1 White Raindrop

Show # heist->cloak.t2
	Rarity Normal Magic Rare
	Class == "Heist Cloaks"
	BaseType == "Hooded Cloak" "Tattered Cloak"
	SetFontSize 45
	PlayAlertSound 3 300
	PlayEffect Grey
	MinimapIcon 1 Grey Raindrop

Hide # heist->cloak.t3any
	Rarity Normal Magic Rare
	Class == "Heist Cloaks"
	SetFontSize 40

