# ===== rules/bottom.filter : hand-written rules, checked AFTER price rules =====

# Maps: generated from reference/league.filter (config.toml [maps]), not here.
# "Hide # league_start" = shown when config league_start = true (applies to any block).

# Gems: the rest is hidden (Awakened / 20% shows are in rules/top.filter)
Hide # league_start
	Class == "Skill Gems" "Support Gems"
	SetFontSize 35

# Hide all regular gear / flasks / jewels that no price rule picked up
Hide
	Class "Abyss Jewels" "Amulets" "Belts" "Body Armours" "Boots" "Bows" "Claws" "Daggers" "Gloves" "Heist Brooches" "Heist Cloaks" "Heist Gear" "Heist Tools" "Helmets" "Hybrid Flasks" "Idols" "Jewels" "Life Flasks" "Mana Flasks" "One Hand Axes" "One Hand Maces" "One Hand Swords" "Quivers" "Rings" "Rune Daggers" "Sceptres" "Shields" "Staves" "Thrusting One Hand Swords" "Tinctures" "Two Hand Axes" "Two Hand Maces" "Two Hand Swords" "Utility Flasks" "Wands" "Warstaves" "Corpses" "Relics" "Trinkets" "Fishing Rods"
	SetFontSize 18
	DisableDropSound True

# Safety net: anything not handled above is unknown -> blue, like your old filter
Show
	SetFontSize 45
	PlayAlertSound 2 300
	PlayEffect Blue
	MinimapIcon 1 Blue Diamond
