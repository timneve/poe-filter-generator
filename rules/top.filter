# ===== rules/top.filter : hand-written rules, checked BEFORE price rules =====
# Edit freely. Standard PoE filter syntax.

# Quest items (heist targets, lab / incursion items: module misc, emit_misc)
Show
	Class == "Quest Items" "Pantheon Souls"
	SetFontSize 45
	PlayAlertSound 3 300
	PlayEffect Green
	MinimapIcon 1 Green Pentagon

# Gold: emit_gold (config.toml show_gold + modules.toml [misc.blocks] gold.*), not here

# Linked items (configured in config.toml)
# BEGIN show_6_links
Show
	LinkedSockets 6
	SetFontSize 45
	SetTextColor red
	SetBorderColor red
	SetBackgroundColor tink_bg
	PlayAlertSound 6 300
	PlayEffect Red
	MinimapIcon 0 Red Star
# END show_6_links

# BEGIN show_5_links
Show
	LinkedSockets 5
	SetFontSize 45
	SetTextColor red
	SetBorderColor red
	SetBackgroundColor tink_bg
	PlayAlertSound 6 300
	PlayEffect Red
	MinimapIcon 0 Red Star
# END show_5_links

# BEGIN show_mirrored
# Mirrored items have unknown / variable value: blue, not a top-tier tink
Show # mirrored items (variable value)
	Mirrored True
	SetFontSize 45
	PlayAlertSound 2 300
	PlayEffect Blue
	MinimapIcon 1 Blue Star
# END show_mirrored


# Gems: expensive exceptional supports + 20% quality not priced higher (poe.ninja gem prices
# come first). Before the gem vendor recipe ([vendor_recipes.gemcutter], tier = floor) so it
# can't restyle them; rest hidden in bottom.filter
Show
	Class == "Skill Gems" "Support Gems"
	BaseType "Awakened" "Enlighten" "Empower" "Enhance"
	SetFontSize 45
	SetTextColor red
	PlayAlertSound 1 300
	PlayEffect Red
	MinimapIcon 1 Red Diamond

Show
	Class == "Skill Gems" "Support Gems"
	Quality >= 20
	SetFontSize 45
	SetTextColor cyan
	PlayEffect Grey
	MinimapIcon 1 Cyan Diamond
