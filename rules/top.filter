# ===== rules/top.filter : hand-written rules, checked BEFORE price rules =====
# Edit freely. Standard PoE filter syntax.

# Quest / lab / heist targets
Show
	Class == "Quest Items" "Labyrinth Items" "Labyrinth Trinkets" "Incursion Items" "Heist Targets" "Pantheon Souls"
	SetFontSize 45
	PlayAlertSound 3 300
	PlayEffect Green
	MinimapIcon 1 Green Pentagon

# BEGIN show_gold
# Big gold stacks only
Show
	BaseType == "Gold"
	StackSize >= 3001
	SetFontSize 45
	SetTextColor 255 212 87
	SetBackgroundColor 0 0 0 0
	PlayEffect Yellow
	MinimapIcon 1 Yellow Cross

# Small gold: shown in the campaign (respec, gambling), hidden in maps
Hide # league_start
	BaseType == "Gold"
	AreaLevel >= 68
	SetFontSize 35

Show
	BaseType == "Gold"
	SetFontSize 35
	SetTextColor 255 212 87
	SetBackgroundColor 0 0 0 0
	DisableDropSound True
# END show_gold

# Linked items (configured in config.toml)
# BEGIN show_6_links
Show
	LinkedSockets 6
	SetFontSize 45
	SetTextColor 255 0 0 255
	SetBorderColor 255 0 0 255
	SetBackgroundColor 255 255 255 255
	PlayAlertSound 6 300
	PlayEffect Red
	MinimapIcon 0 Red Star
# END show_6_links

# BEGIN show_5_links
Show
	LinkedSockets 5
	SetFontSize 45
	SetTextColor 255 0 0 255
	SetBorderColor 255 0 0 255
	SetBackgroundColor 255 255 255 255
	PlayAlertSound 6 300
	PlayEffect Red
	MinimapIcon 0 Red Star
# END show_5_links

# BEGIN show_mirrored
# Mirrored items have unknown / variable value: blue, not a top-tier tink
Show # mirrored items (variable value)
	Mirrored True
	SetFontSize 45
	PlayAlertSound 2 300
	PlayEffect Blue
	MinimapIcon 1 Blue Star
# END show_mirrored


# Gems: expensive exceptional supports + 20% quality. Before the price rules so the gem
# vendor recipe ([vendor_recipes.gemcutter], tier = floor) can't restyle them; rest hidden in bottom.filter
Show
	Class == "Skill Gems" "Support Gems"
	BaseType "Awakened" "Enlighten" "Empower" "Enhance"
	SetFontSize 45
	SetTextColor 255 0 0 255
	PlayAlertSound 1 300
	PlayEffect Red
	MinimapIcon 1 Red Diamond

Show
	Class == "Skill Gems" "Support Gems"
	Quality >= 20
	SetFontSize 45
	SetTextColor 20 240 240
	PlayEffect Grey
	MinimapIcon 1 Cyan Diamond
